{
    "name": "sentra_guard",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "chain:compile": "hardhat compile",
        "chain:test": "hardhat test",
        "chain:node": "hardhat node",
        "chain:deploy:local": "hardhat run scripts/deploy-token.ts --network localhost",
        "chain:deploy:sepolia": "hardhat run scripts/deploy-token.ts --network sepolia",
        "check:backend": "tsc -p backend/tsconfig.json --noEmit",
        "check:review": "npm run build && npm run lint",
        "db:health": "node scripts/db-health.mjs",
        "db:migrate": "node scripts/db-health.mjs --migrate",
        "test:backend-smoke": "node scripts/backend-smoke.mjs",
        "backend:dev": "node backend/server.mjs",
        "backend:start": "node backend/server.mjs",
        "worker:audit": "node backend/workers/auditWorker.mjs",
        "prod:compose": "docker compose -f docker-compose.production.yml --env-file .env.production up --build",
        "prod:readiness": "node -e \"fetch(process.env.BACKEND_API_URL || 'http://localhost:8787/readiness').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\"",
        "demo:realtime": "powershell -ExecutionPolicy Bypass -File scripts/push-sentracore-full-realtime-demo.ps1"
    },
    "dependencies": {
        "@metamask/detect-provider": "^2.0.0",
        "dotenv": "^17.4.2",
        "ethers": "^6.16.0",
        "lucide-react": "^1.16.0",
        "pg": "^8.20.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router-dom": "^7.15.0",
        "redis": "^5.12.1",
        "web3": "^4.16.0",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nomicfoundation/hardhat-toolbox": "^6.1.2",
        "@openzeppelin/contracts": "^5.6.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^10.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "hardhat": "^2.28.6",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.10"
    }
}
