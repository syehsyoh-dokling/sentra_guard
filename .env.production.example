SERVICE_NAME=sentracore-audit-backend
PUBLIC_APP_URL=https://app.example.com
BACKEND_API_URL=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com

POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_URL=postgres://sentracore:replace-with-strong-password@postgres:5432/sentracore
REDIS_URL=redis://redis:6379/0

ADMIN_BOOTSTRAP_TOKEN=replace-with-admin-token
AUTH_ISSUER_URL=https://accounts.google.com
AUTH_CLIENT_SECRET=replace-with-oauth-secret
JWT_SECRET=replace-with-jwt-secret
SESSION_ENCRYPTION_KEY=replace-with-session-secret

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SOLANA_RPC_URL=https://api.devnet.solana.com
BNB_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
POLYGON_RPC_URL=https://polygon-amoy.drpc.org

STORAGE_BUCKET_URL=s3://sentracore-audit-reports/production
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_API_TOKEN=replace-with-ipfs-token

DOCKER_REGISTRY_URL=https://registry-1.docker.io/v2/
GIT_REPOSITORY_URL=https://github.com/syehsyoh-dokling/blockchain
OBSERVABILITY_URL=https://grafana.example.com
ERROR_TRACKING_DSN=replace-with-sentry-dsn

QUEUE_CONCURRENCY=8
AUDIT_RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=120
